{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "QNX: build debug",
      "command": "mkdir -p ${config:qnx.arch} && qcc -Vgcc_nto${config:qnx.arch} -g -O0 -o ${config:qnx.arch}/${workspaceFolderBasename} *.c",
      "windows": {
        "command": "bash",
        "args": [
          "-c",
          "mkdir -p ${config:qnx.arch} && qcc -Vgcc_nto${config:qnx.arch} -g -O0 -o ${config:qnx.arch}/${workspaceFolderBasename} *.c"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "QNX_HOST": "__HOME__/qnx800/host/linux/x86_64",
          "QNX_TARGET": "__HOME__/qnx800/target/qnx",
          "MAKEFLAGS": "-I__HOME__/qnx800/target/qnx/usr/include",
          "PATH": "__HOME__/qnx800/host/linux/x86_64/usr/bin:${env:PATH}"
        }
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "QNX: clean",
      "command": "rm -rf x86_64 aarch64le *-debug",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "QNX_HOST": "__HOME__/qnx800/host/linux/x86_64",
          "QNX_TARGET": "__HOME__/qnx800/target/qnx",
          "MAKEFLAGS": "-I__HOME__/qnx800/target/qnx/usr/include",
          "PATH": "__HOME__/qnx800/host/linux/x86_64/usr/bin:${env:PATH}"
        }
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    }
  ]
}
